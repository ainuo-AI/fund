# AI 新闻分析配置（复制本文件为 .env 并填入自己的 key；.env 已被 .gitignore 忽略，不会上传）
# 默认适配 DeepSeek（https://platform.deepseek.com 注册，价格便宜，OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 用 Kimi 开放平台（platform.moonshot.cn）的话改成：
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-8k

# 用 Kimi Code 编程套餐（platform.kimi.ai，key 是 sk-kimi- 前缀）的话改成：
# AI_BASE_URL=https://api.kimi.com/coding/v1
# AI_MODEL=kimi-k2

# 用 OpenAI 的话改成：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
